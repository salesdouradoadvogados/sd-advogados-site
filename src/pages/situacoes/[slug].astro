---
// Situação, o caminho (spec v2, §3.2). Título na voz da leitora (itálico).
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Pergunta from '../../components/Pergunta.astro';
import Assinatura from '../../components/Assinatura.astro';
import Imprimir from '../../components/Imprimir.astro';
import { getEntry } from 'astro:content';
import { situacoes, respostas, revisao, etapasPorExtenso, url, type Situacao } from '../../lib/conteudo';
import { site } from '../../site.config';

export async function getStaticPaths() {
  return (await situacoes()).map((situacao) => ({ params: { slug: situacao.id }, props: { situacao } }));
}

interface Props { situacao: Situacao }
const { situacao } = Astro.props;
const d = situacao.data;
const rev = revisao(situacao);
const pessoa = await getEntry(d.revisado_por);
const areaPrincipal = await getEntry(d.areas[0]);
const enderecoDaPagina = new URL(url.situacao(situacao.id), site.url).href;

// Todas as perguntas da situação, sem repetir: as das etapas, as das
// bifurcações e as respostas escritas que apontam para ela.
type Linha = { pergunta: string; slug?: string; contexto: string };
const todas: Linha[] = [];
const vistas = new Set<string>();
const somar = (l: Linha) => {
  const chave = l.slug ?? l.pergunta;
  if (vistas.has(chave)) return;
  vistas.add(chave);
  todas.push(l);
};
d.etapas.forEach((e, i) => e.respostas.forEach((r) => somar({ ...r, contexto: `Etapa ${i + 1} · ${e.titulo}` })));
d.bifurcacoes.forEach((b) => somar({ ...b.pergunta, contexto: 'O que muda o caminho' }));
for (const r of await respostas()) {
  if (r.data.situacoes.some((s) => s.id === situacao.id)) {
    const i = d.etapas.findIndex((e) => e.slug === r.data.etapa);
    somar({ pergunta: r.data.pergunta, slug: r.id, contexto: i >= 0 ? `Etapa ${i + 1} · ${d.etapas[i].titulo}` : d.titulo });
  }
}
---
<Base titulo={d.titulo} descricao={d.resumo} atual="situacoes" exemplo={d.exemplo}>
  <Crumbs itens={[{ rotulo: 'Início', href: url.inicio }, { rotulo: 'Situações', href: url.situacoes }, { rotulo: d.titulo }]} />
  <section class="hero-int">
    <div class="wrap grid-8-4">
      <div data-pagefind-body data-pagefind-meta="title[data-titulo], contexto[data-contexto]" data-titulo={d.titulo} data-contexto={`Situação · ${areaPrincipal.data.titulo}`}>
        <p class="eyebrow">Situação · {areaPrincipal.data.titulo}</p>
        <h1 class="display it">{d.titulo}</h1>
        <p class="lead muted">{d.resumo}</p>
        <div class="meta">
          <p><b>Revisão</b> {rev.feita ? `em ${rev.texto}` : 'pendente'}</p>
          <p><b>por</b> {pessoa.data.nome}, {pessoa.data.oab}</p>
          <p><b>Área</b> <a href={url.area(areaPrincipal.id)}>{areaPrincipal.data.titulo}</a></p>
        </div>
      </div>
      <aside class="ficha" aria-label="O caminho">
        <h2>O caminho, em {etapasPorExtenso(d.etapas.length)}</h2>
        <ul>{d.etapas.map((e, i) => <li><a href={`#${e.slug}`}>{i + 1}. {e.titulo}</a></li>)}</ul>
        <div class="acoes">
          <a class="btn btn-gold" href={url.conversar}>Falar com o escritório</a>
          {d.documentos.length > 0 && <a class="btn btn-line" href="#documentos">Lista de documentos</a>}
        </div>
      </aside>
    </div>
  </section>

  <section class="sec white" aria-labelledby="caminho-titulo">
    <div class="wrap grid-8-4">
      <div>
        <div class="sec-head" style="margin-bottom: 48px">
          <p class="eyebrow">O caminho</p>
          <h2 class="h2" id="caminho-titulo">Na ordem em que acontece.</h2>
        </div>
        <ol class="fio cascata" data-pagefind-body>
          {d.etapas.map((e, i) => (
            <li class="etapa" id={e.slug} style={`--i: ${i}`}>
              <span class="etapa-n" aria-hidden="true">{i + 1}</span>
              <h3 class="h3"><span class="sr-only">Etapa {i + 1}: </span>{e.titulo}</h3>
              <p>{e.texto}</p>
              {(e.respostas.length > 0 || e.liga_documentos) && (
                <div class="perg">
                  {e.respostas.map((r) => <Pergunta {...r} />)}
                  {e.liga_documentos && <a href="#documentos">Ver a lista de documentos</a>}
                </div>
              )}
            </li>
          ))}
        </ol>
      </div>
      <aside class="aside" aria-label="Sobre esta situação">
        {d.bifurcacoes.length > 0 && (
          <div class="bloco">
            <h2>O que muda o caminho</h2>
            <ul>{d.bifurcacoes.map((b, i) => <li><a href={`#muda-${i + 1}`}>{b.titulo}</a></li>)}</ul>
          </div>
        )}
        <div class="bloco"><h2>Quem revisa</h2><Assinatura pessoa={d.revisado_por.id} linha={rev.feita ? `revisado em ${rev.texto}` : 'revisão pendente'} /></div>
        <div class="bloco acoes"><a class="btn btn-line" href={url.conversar}>Falar com o escritório</a></div>
      </aside>
    </div>
  </section>

  {d.bifurcacoes.length > 0 && (
    <section class="sec" aria-labelledby="muda-titulo">
      <div class="wrap">
        <div class="sec-head">
          <p class="eyebrow">O que muda o caminho</p>
          <h2 class="h2" id="muda-titulo">{d.bifurcacoes.length === 3 ? 'Três situações que trocam a ordem.' : 'Situações que trocam a ordem.'}</h2>
        </div>
        <div class="cartoes">
          {d.bifurcacoes.map((b, i) => (
            <div class="cartao" id={`muda-${i + 1}`}>
              <h3 class="h4">{b.titulo}</h3>
              <p>{b.texto}</p>
              {b.pergunta.slug ? (
                <a href={url.resposta(b.pergunta.slug)}>{b.pergunta.pergunta}</a>
              ) : (
                <span class="prevista">{b.pergunta.pergunta} <span class="em-prep">em preparação</span></span>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {d.documentos.length > 0 && (
    <section class="sec white" id="documentos" aria-labelledby="docs-titulo">
      <div class="wrap grid-5-7">
        <div>
          <p class="eyebrow">Documentos para separar</p>
          <h2 class="h2" id="docs-titulo">O que levar para a primeira conversa.</h2>
          <p class="lead muted" style="margin-top: 22px">Nada aqui impede de começar. O que faltar, o escritório ajuda a reunir.</p>
          <div class="cta-row"><Imprimir alvo="documentos" rotulo="Imprimir a lista" /></div>
        </div>
        <ul class="check">{d.documentos.map((doc) => <li>{doc}</li>)}</ul>
      </div>
    </section>
  )}

  {todas.length > 0 && (
    <section class="sec" aria-labelledby="todas-titulo">
      <div class="wrap">
        <div class="sec-head">
          <p class="eyebrow">Todas as perguntas desta situação</p>
          <h2 class="h2" id="todas-titulo">Respondidas nas duas primeiras frases.</h2>
        </div>
        <ul class="q-grid">
          {todas.map((l) => (
            <li>
              {l.slug ? (
                <a class="linha" href={url.resposta(l.slug)}><span class="q">{l.pergunta}</span><span class="s">{l.contexto}</span></a>
              ) : (
                <div class="linha prevista"><span class="q">{l.pergunta}</span><span class="s">{l.contexto} · <span class="em-prep">em preparação</span></span></div>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <div class="so-impressao wrap">
    <p class="small">{d.titulo} · {enderecoDaPagina}</p>
    <p class="small">{rev.feita ? `Revisado em ${rev.texto}` : 'Revisão pendente'} por {pessoa.data.nome}, {pessoa.data.oab}. {site.nomeCanonico}. Texto informativo, que não substitui a análise do seu caso.</p>
  </div>
</Base>
