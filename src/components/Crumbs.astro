---
// Trilha de navegação. O último item é a página atual, sem link.
interface Props {
  itens: { rotulo: string; href?: string }[];
}
const { itens } = Astro.props;
---
<div class="wrap">
  <nav class="crumbs" aria-label="Você está em">
    <ol>
      {itens.map((i, n) => (
        <li>
          {n > 0 && <span class="sep" aria-hidden="true">›</span>}
          {i.href ? <a href={i.href}>{i.rotulo}</a> : <span aria-current="page">{i.rotulo}</span>}
        </li>
      ))}
    </ol>
  </nav>
</div>
