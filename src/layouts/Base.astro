---
// Moldura de toda página: cabeçalho, conteúdo, faixa de contato e rodapé.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Faixa from '../components/Faixa.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site.config';
import { emPrevia, indexavel } from '../lib/conteudo';

interface Props {
  titulo: string;
  descricao: string;
  /** Item do menu marcado como página atual. */
  atual?: 'situacoes' | 'areas' | 'respostas' | 'escritorio' | 'atendimento';
  /** Texto de exemplo, ainda não escrito pelo escritório: mostra a faixa. */
  exemplo?: boolean;
}

const { titulo, descricao, atual, exemplo = false } = Astro.props;
const tituloCompleto = Astro.url.pathname === '/' ? `${site.nomeCanonico} · ${titulo}` : `${titulo} · ${site.nomeCanonico}`;
const canonica = new URL(Astro.url.pathname, site.url).href;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonica} />
    {!indexavel && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#f7f4ee" />{/* ivory: a meta não aceita variável CSS */}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/playfair-display-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/playfair-display-latin-wght-italic.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.nomeCanonico} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonica} />
    <slot name="head" />
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    {emPrevia && (
      <aside class="previa" aria-label="Aviso da prévia">
        <div class="wrap"><b>Prévia do site.</b> Não indexada. {exemplo ? 'O texto desta página é exemplo de formato e ainda não foi escrito nem revisado pelo escritório.' : 'Dados marcados "a confirmar" ainda dependem do escritório.'}</div>
      </aside>
    )}
    <Header atual={atual} />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Faixa />
    <Footer />
  </body>
</html>
